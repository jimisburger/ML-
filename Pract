# Building the model
#Calculating the means
X_mean = np.mean(X)
Y_mean = np.mean(Y)

cov = 0
var = 0

for i in range(len(X)):
    cov += (X[i] - X_mean)*(Y[i] - Y_mean)  # Calculate the covariance of X and Y
    var += (X[i] - X_mean)**2  # Calculate the variance of X

