CODE - Practical5_Staging.py (Airflow 2-style imports)
from datetime import datetime
import pandas as pd
import psycopg2
from airflow import DAG
from airflow.operators.python import PythonOperator

STAGING_FILE = "/home/ubuntu/staging/users_staging.csv"

def extract_data():
    conn = psycopg2.connect(
        host="localhost", database="DE",
        user="postgres", password="postgres"
    )
    try:
        df = pd.read_sql_query("SELECT * FROM users", conn)
        df.to_csv(STAGING_FILE, index=False)
    finally:
        conn.close()

def load_data():
    df = pd.read_csv(STAGING_FILE)
    print(df)
    print("Staged file successfully read.")

with DAG(
    dag_id="Practical5_Staging",
    start_date=datetime(2026, 1, 1),
    schedule=None,
    catchup=False,
) as dag:
    extract_task = PythonOperator(
        task_id="extract_and_stage", python_callable=extract_data
    )
    load_task = PythonOperator(
        task_id="read_staged_file", python_callable=load_data
    )
    extract_task >> load_task

5. Replace /home/ubuntu/staging/users_staging.csv with a path that exists for the Airflow user; create the directory and grant write access.
6. Run/refresh the scheduler and webserver, open http://localhost:8080, unpause the DAG and trigger it.
7. Verify that the file exists and both tasks succeed.
Expected output: users_staging.csv is created from PostgreSQL; the second task's logs show the contents and "Staged file successfully read." The second task runs only after extraction succeeds.

